<style>
  footer {
    background-color: #f8f9fa;
    padding: 2rem 0;
    margin-top: auto;
  }
  .f-info {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    padding: 0 1rem;
  }
  .f-info-socials {
    display: flex;
    gap: 1rem;
  }
  .f-info-socials i {
    font-size: 1.5rem;
    color: #fe424d;
    transition: transform 0.3s ease;
  }
  .f-info-socials i:hover {
    transform: scale(1.2);
  }
  .f-info-brand {
    font-weight: 500;
  }
  .f-info-links {
    display: flex;
    gap: 1rem;
  }
  .f-info-links a {
    color: #6c757d;
    text-decoration: none;
    transition: color 0.3s ease;
  }
  .f-info-links a:hover {
    color: #fe424d;
  }
  @media (max-width: 768px) {
    .f-info {
      flex-direction: column;
      text-align: center;
    }
    .f-info-socials {
      margin-bottom: 1rem;
    }
    .f-info-brand {
      margin-bottom: 1rem;
    }
  }
</style>

<footer>
  <div class="f-info">
    <div class="f-info-socials">
      <a href="#" aria-label="Facebook"><i class="fa-brands fa-square-facebook"></i></a>
      <a href="#" aria-label="Instagram"><i class="fa-brands fa-square-instagram"></i></a>
      <a href="#" aria-label="LinkedIn"><i class="fa-brands fa-linkedin"></i></a>
    </div>
    <div class="f-info-brand">&copy; holiday-z  Private Limited</div>
    <div class="f-info-links">
      <a href="/private">Privacy</a>
      <a href="/terms">Terms</a>
    </div>
  </div>
</footer>