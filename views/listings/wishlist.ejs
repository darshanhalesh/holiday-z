<% layout("/layouts/boilerplate") %>

<div class="container mt-5">
    <h1 class="mb-4 px-3">My Wishlist</h1>
    
    <% if(listings && listings.length > 0) { %>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 px-3">
            <% listings.forEach(listing => { %>
                <div class="col">
                    <div class="card h-100">
                        <div class="position-relative">
                            <img src="<%=listing.images && listing.images[0] ? listing.images[0].url : '/images/default-listing.jpg' %>" class="card-img-top" style="height:20rem"/>
                            <form action="/wishlist/<%= listing._id %>" method="POST" class="position-absolute top-0 end-0 m-2">
                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Remove from wishlist">
                                    <i class="fas fa-heart"></i> Remove
                                </button>
                            </form>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title"><%= listing.title %></h5>
                            <p class="card-text"><%= listing.description %></p>
                            <p class="card-text"><small class="text-muted">Location: <%= listing.location %></small></p>
                            <p class="card-text"><small class="text-muted">Price: ₹<%= listing.price %></small></p>
                            <div class="d-flex justify-content-between align-items-center">
                                <a href="/listings/<%= listing._id %>" class="btn btn-primary">View Details</a>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <div class="alert alert-info mx-3">
            Your wishlist is empty. Start adding listings to your wishlist!
        </div>
    <% } %>
</div>

<style>
    .card-img-top-container {
        height: 200px;
        overflow: hidden;
    }
    .card-img-top {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .card {
        transition: transform 0.3s ease;
    }
    .card:hover {
        transform: translateY(-5px);
    }
</style> 