<% layout("/layouts/boilerplate") %>
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h2 class="mb-4">My Wishlist</h2>
        </div>
    </div>
    
    <% if(listings && listings.length > 0) { %>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            <% listings.forEach(listing => { %>
                <div class="col">
                    <div class="card h-100">
                        <div class="card-img-top-container">
                            <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>">
                        </div>
                        <div class="card-body">
                            <h5 class="card-title"><%= listing.title %></h5>
                            <p class="card-text"><%= listing.description.substring(0, 100) %>...</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted"><%= listing.location %>, <%= listing.country %></span>
                                <span class="fw-bold">$<%= listing.price %></span>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent">
                            <div class="d-flex justify-content-between">
                                <a href="/listings/<%= listing._id %>" class="btn btn-outline-primary">View Details</a>
                                <form action="/wishlist/<%= listing._id %>?_method=DELETE" method="POST">
                                    <button type="submit" class="btn btn-outline-danger">
                                        <i class="fas fa-heart"></i> Remove
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <div class="alert alert-info">
            <p class="mb-0">Your wishlist is empty. Start adding your favorite destinations!</p>
        </div>
    <% } %>
</div>

<style>
    .card-img-top-container {
        height: 200px;
        overflow: hidden;
    }
    .card-img-top {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .card {
        transition: transform 0.3s ease;
    }
    .card:hover {
        transform: translateY(-5px);
    }
</style> 