<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <h1 class="col-6 offset-3">sign up for wanderlust</h1>
    <div class="col-8 offset-2">
 <form method="post" action="signup" class="needs-validations" novalidate>
    <div class="mb-3">
        <label for="username" class="form-label">username</label>
        <input name="username" id="username"  type="text" class="form-control" required>
        <div class="valid-feedback"> seems good</div>
      </div>
      <div class="mb-3">
        <label for="email" class="form-label">email</label>
        <input name="email" id="username"  type="email" class="form-control" required>
        
      </div>
      <div class="mb-3">
        <label for="password" class="form-label">password</label>
        <input name="password" id="password"  type="password" class="form-control" required>
        <div class="valid-feedback"> seems good</div>
      </div>

      <button class="btn btn-success">signup</button>

 </form>

        </div>
        </div>