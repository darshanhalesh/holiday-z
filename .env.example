# MongoDB Atlas Connection String
# Get this from: https://cloud.mongodb.com
# For local development, use: mongodb://127.0.0.1:27017/holidayz
ATLAS_DB_TOKEN=your-mongodb-connection-uri

# Cloudinary Configuration
# Get these from: https://cloudinary.com/console
CLOUD_NAME=your-cloudinary-cloud-name
CLOUD_API_KEY=your-cloudinary-api-key
CLOUD_API_SECRET=your-cloudinary-api-secret

# Mapbox Access Token
# Get this from: https://account.mapbox.com/access-tokens/
MAP_TOKEN=your-mapbox-access-token

# Session Secret (use a random string)
SECRET=your-secret-key

# Server Port (default: 8080)
PORT=8080

# Node Environment (development or production)
NODE_ENV=development
